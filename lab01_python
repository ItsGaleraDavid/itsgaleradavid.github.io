<script>
    const wsUri = "ws://localhost:8768";
    const statusBox = document.getElementById("connection-status");
    const cpuVal = document.getElementById("cpu-val");
    const cpuBar = document.getElementById("cpu-bar");
    const ramVal = document.getElementById("ram-val");
    const ramBar = document.getElementById("ram-bar");
    const diskVal = document.getElementById("disk-val");
    const diskBar = document.getElementById("disk-bar");
    const procVal = document.getElementById("proc-val");
    const netVal = document.getElementById("net-val");
    const osVal = document.getElementById("os-val");
    const logDiv = document.getElementById("log");

    function formatBytes(bytes) {
        if (bytes === 0) return '0 B';
        const k = 1024;
        const sizes = ['B', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    }

    function addLog(msg) {
        const timestamp = new Date().toLocaleTimeString();
        logDiv.innerHTML += `[${timestamp}] ${msg}<br>`;
        logDiv.scrollTop = logDiv.scrollHeight;
    }

    function connect() {
        const websocket = new WebSocket(wsUri);

        websocket.onopen = () => {
            statusBox.className = "status-online";
            statusBox.innerText = "Connected (Port 8768)";
            addLog("WebSocket tunnel established.");
        };

        websocket.onmessage = (event) => {
            const data = JSON.parse(event.data);

            osVal.innerText = data.system;
            cpuVal.innerText = data.cpu_percent.toFixed(1);
            ramVal.innerText = data.memory_percent.toFixed(1);
            diskVal.innerText = data.disk_percent.toFixed(1);

            cpuBar.style.width = data.cpu_percent + "%";
            ramBar.style.width = data.memory_percent + "%";
            diskBar.style.width = data.disk_percent + "%";

            procVal.innerText = data.processes_count;
            netVal.innerText = `${formatBytes(data.bytes_sent)} / ${formatBytes(data.bytes_recv)}`;
        };

        websocket.onclose = () => {
            statusBox.className = "status-offline";
            statusBox.innerText = "Disconnected (Retrying...)";
            addLog("Connection lost. Reconnecting...");
            setTimeout(connect, 2000);
        };
    }

    connect();
</script>

